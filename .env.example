# Enter the complete PostgreSQL URI with the username and password.
# Bundled PostgreSQL uses postgres://sub_pool:YOUR_PASSWORD@postgres:5432/sub_pool?sslmode=disable
# For a PostgreSQL server you already have, enter its connection URI.
SUB_POOL_DATABASE_URL=

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key with your database backup; changing it makes stored secrets unreadable.
SUB_POOL_SECRET_KEY=

IMAGE_TAG=main
SUB_POOL_PUBLIC_ORIGIN=http://127.0.0.1:3000
SUB_POOL_BIND=127.0.0.1
SUB_POOL_HOST=127.0.0.1
SUB_POOL_PORT=3000

# Required for the private loopback Go connection, including with a public HTTPS origin.
# Public HTTPS still produces Secure cookies and requires an exact matching Origin.
SUB_POOL_ALLOW_LOOPBACK_HTTP=true
