+func (r *idempotencyRepository) WithTransaction(ctx context.Context, record *service.IdempotencyRecord, execute func(context.Context) error) error {
+	if r.client == nil {
+		return service.ErrIdempotencyStoreUnavail
+	}
+	tx, err := r.client.Tx(ctx)
+	if err != nil {
+		return service.ErrIdempotencyStoreUnavail.WithCause(err)
+	}
+	defer func() { _ = tx.Rollback() }()
+	var id int64
+	// Lock and fence the claim: a delayed owner must not execute after a reclaim.
+	err = scanSingleRow(ctx, tx.Client(), `SELECT id FROM idempotency_records
+		WHERE id = $1 AND status = $2 AND locked_until = $3 FOR UPDATE`,
+		[]any{record.ID, service.IdempotencyStatusProcessing, record.LockedUntil}, &id)
+	if errors.Is(err, sql.ErrNoRows) {
+		return service.ErrIdempotencyInProgress
+	}
+	if err != nil {
+		return service.ErrIdempotencyStoreUnavail.WithCause(err)
+	}
+	if err := execute(dbent.NewTxContext(ctx, tx)); err != nil {
+		return err
+	}
+	if err := tx.Commit(); err != nil {
+		return service.ErrIdempotencyStoreUnavail.WithCause(err)
+	}
+	return nil
 }
 
