+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const { post } = vi.hoisted(() => ({ post: vi.fn() }))
+vi.mock('../client', () => ({ apiClient: { post } }))
+
+describe('administrator balance intent keys', () => {
+  beforeEach(() => {
+    vi.resetModules()
+    post.mockReset()
+    localStorage.clear()
+    sessionStorage.clear()
+    localStorage.setItem('auth_user', JSON.stringify({ id: 7 }))
+  })
+
+  it('reuses the key after a lost response and a module reload, then retires it on success', async () => {
+    const api = await import('../admin/users')
+    post.mockRejectedValueOnce(new Error('response lost'))
+    await expect(api.updateBalance(2, 1, 'add', 'test')).rejects.toThrow('response lost')
+    const first = post.mock.calls[0]![2].headers['Idempotency-Key']
+    vi.resetModules()
+    const reloaded = await import('../admin/users')
+    post.mockResolvedValue({ data: { id: 2 } })
+    await reloaded.updateBalance(2, 1, 'add', 'test')
+    expect(post.mock.calls[1]![2].headers['Idempotency-Key']).toBe(first)
+    await reloaded.updateBalance(2, 1, 'add', 'test')
+    expect(post.mock.calls[2]![2].headers['Idempotency-Key']).not.toBe(first)
+  })
+
+  it('separates actors and changed financial intents', async () => {
+    const api = await import('../admin/users')
+    post.mockRejectedValue(new Error('response lost'))
+    await expect(api.updateBalance(2, 1, 'add')).rejects.toThrow()
+    await expect(api.updateBalance(2, 2, 'add')).rejects.toThrow()
+    localStorage.setItem('auth_user', JSON.stringify({ id: 8 }))
+    await expect(api.updateBalance(2, 1, 'add')).rejects.toThrow()
+    const keys = post.mock.calls.map(call => call[2].headers['Idempotency-Key'])
+    expect(new Set(keys).size).toBe(3)
+  })
+
+  it('does not dispatch when the actor or durable key storage is unavailable', async () => {
+    const api = await import('../admin/users')
+    localStorage.removeItem('auth_user')
+    await expect(api.updateBalance(2, 1, 'add')).rejects.toThrow()
+    expect(post).not.toHaveBeenCalled()
+    localStorage.setItem('auth_user', JSON.stringify({ id: 7 }))
+    vi.stubGlobal('sessionStorage', { getItem: () => null, setItem: () => { throw new Error('storage blocked') } })
+    await expect(api.updateBalance(2, 1, 'add')).rejects.toThrow('storage blocked')
+    expect(post).not.toHaveBeenCalled()
+    vi.unstubAllGlobals()
+  })
+})
