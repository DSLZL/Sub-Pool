+// Use a migrated disposable local database; no Docker or production credentials.
+func TestFinancialAtomicityPostgres(t *testing.T) {
+	dsn := os.Getenv("SUB2API_FINANCE_TEST_DSN")
+	if dsn == "" {
+		t.Skip("SUB2API_FINANCE_TEST_DSN is not set")
+	}
+	db, err := sql.Open("postgres", dsn)
+	require.NoError(t, err)
+	defer db.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	var database, address string
+	require.NoError(t, db.QueryRowContext(ctx, "SELECT current_database(), inet_server_addr()::text").Scan(&database, &address))
+	require.True(t, strings.HasPrefix(database, "subpool_test_"), "disposable test database required")
+	require.Contains(t, []string{"127.0.0.1/32", "127.0.0.1", "::1/128", "::1"}, address)
+	client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+	marker := fmt.Sprintf("atomic-%d", time.Now().UnixNano())
+	u, err := client.User.Create().SetEmail(marker + "@local.invalid").SetPasswordHash("unused-test-hash").SetBalance(100).Save(ctx)
+	require.NoError(t, err)
+	k, err := client.APIKey.Create().SetUserID(u.ID).SetKey(marker).SetName(marker).SetQuota(100).Save(ctx)
+	require.NoError(t, err)
+	a, err := client.Account.Create().SetName(marker).SetPlatform(service.PlatformOpenAI).SetType(service.AccountTypeAPIKey).SetCredentials(map[string]any{}).Save(ctx)
+	require.NoError(t, err)
+	repo := NewUsageBillingRepository(client, db)
+	cmd := service.UsageBillingCommand{RequestID: marker, APIKeyID: k.ID, UserID: u.ID, AccountID: a.ID, BalanceCost: 2.5, APIKeyQuotaCost: 2.5,
+		UsageLog: &service.UsageLog{RequestID: marker, APIKeyID: k.ID, UserID: u.ID, AccountID: a.ID, Model: "atomic-test", InputTokens: 1000, OutputTokens: 500, ActualCost: 2.5, TotalCost: 2.5}}
+	exec := func(query string, args ...any) {
+		_, err := db.ExecContext(ctx, query, args...)
+		require.NoError(t, err)
+	}
+	fault := fmt.Sprintf("finance_fault_%d", u.ID)
+	exec(fmt.Sprintf("CREATE FUNCTION %s() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.user_id = %d THEN RAISE EXCEPTION 'finance log fault'; END IF; RETURN NEW; END $$", fault, u.ID))
+	exec(fmt.Sprintf("CREATE TRIGGER %s BEFORE INSERT ON usage_logs FOR EACH ROW EXECUTE FUNCTION %s()", fault, fault))
+	defer func() {
+		_, _ = db.ExecContext(context.Background(), fmt.Sprintf("DROP TRIGGER IF EXISTS %s ON usage_logs; DROP FUNCTION IF EXISTS %s()", fault, fault))
+	}()
+	_, err = repo.Apply(ctx, &cmd)
+	require.ErrorContains(t, err, "finance log fault")
+	check := func(balance, cost float64, count int) {
+		var gotBalance, gotCost, quota float64
+		var logs, claims int
+		require.NoError(t, db.QueryRowContext(ctx, "SELECT balance FROM users WHERE id=$1", u.ID).Scan(&gotBalance))
+		require.NoError(t, db.QueryRowContext(ctx, "SELECT COALESCE(sum(actual_cost),0),count(*) FROM usage_logs WHERE user_id=$1", u.ID).Scan(&gotCost, &logs))
+		require.NoError(t, db.QueryRowContext(ctx, "SELECT count(*) FROM usage_billing_dedup WHERE api_key_id=$1", k.ID).Scan(&claims))
+		require.NoError(t, db.QueryRowContext(ctx, "SELECT quota_used FROM api_keys WHERE id=$1", k.ID).Scan(&quota))
+		require.Equal(t, balance, gotBalance)
+		require.Equal(t, cost, gotCost)
+		require.Equal(t, cost, quota)
+		require.Equal(t, count, logs)
+		require.Equal(t, count, claims)
+	}
+	check(100, 0, 0)
+	exec(fmt.Sprintf("DROP TRIGGER %s ON usage_logs", fault))
+	result, err := repo.Apply(ctx, &cmd)
+	require.NoError(t, err)
+	require.True(t, result.Applied)
+	check(97.5, 2.5, 1)
+	result, err = repo.Apply(ctx, &cmd)
+	require.NoError(t, err)
+	require.False(t, result.Applied)
+	check(97.5, 2.5, 1)
+	cmd.RequestID += "-concurrent"
+	cmd.RequestFingerprint = ""
+	log := *cmd.UsageLog
+	log.RequestID = cmd.RequestID
+	cmd.UsageLog = &log
+	var wg sync.WaitGroup
+	errs := make(chan error, 12)
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			copyCmd, copyLog := cmd, *cmd.UsageLog
+			copyCmd.UsageLog = &copyLog
+			_, err := repo.Apply(ctx, &copyCmd)
+			errs <- err
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	check(95, 5, 2)
+}
