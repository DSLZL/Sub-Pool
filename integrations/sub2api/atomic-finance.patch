+func TestAtomicIdempotency_ReceiptFailureRollsBackBusinessWrites(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+	repo := NewIdempotencyRepository(client, db)
+	lock := time.Now().Truncate(time.Microsecond)
+	mock.ExpectBegin()
+	mock.ExpectQuery("SELECT id FROM idempotency_records").WithArgs(int64(1), service.IdempotencyStatusProcessing, lock).
+		WillReturnRows(sqlmock.NewRows([]string{"id"}).AddRow(1))
+	mock.ExpectExec("UPDATE users SET balance").WillReturnResult(sqlmock.NewResult(0, 1))
+	mock.ExpectExec("UPDATE idempotency_records").WillReturnError(errors.New("receipt unavailable"))
+	mock.ExpectRollback()
+	err = repo.(service.AtomicIdempotencyRepository).WithTransaction(context.Background(), &service.IdempotencyRecord{ID: 1, LockedUntil: &lock}, func(ctx context.Context) error {
+		tx := dbent.TxFromContext(ctx)
+		require.NotNil(t, tx)
+		_, err := tx.Client().ExecContext(ctx, "UPDATE users SET balance = balance + 1 WHERE id = 1")
+		require.NoError(t, err)
+		return repo.MarkSucceeded(ctx, 1, 200, "{}", time.Now().Add(time.Hour))
+	})
+	require.ErrorContains(t, err, "receipt unavailable")
+	require.NoError(t, mock.ExpectationsWereMet())
+}
