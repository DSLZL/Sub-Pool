diff --git a/backend/internal/service/financial_atomicity_test.go b/backend/internal/service/financial_atomicity_test.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/service/financial_atomicity_test.go
@@ -0,0 +1,104 @@
+//go:build unit
+
+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type atomicIdempotencyTestRepo struct {
+	*inMemoryIdempotencyRepo
+	commitErr error
+	inside    bool
+}
+
+func (r *atomicIdempotencyTestRepo) WithTransaction(ctx context.Context, _ *IdempotencyRecord, fn func(context.Context) error) error {
+	r.inside = true
+	defer func() { r.inside = false }()
+	if err := fn(ctx); err != nil {
+		return err
+	}
+	return r.commitErr
+}
+
+func TestIdempotencyCoordinator_AtomicModeFailsClosed(t *testing.T) {
+	for _, key := range []string{"", "atomic-key"} {
+		repo := newInMemoryIdempotencyRepo()
+		_, err := NewIdempotencyCoordinator(repo, DefaultIdempotencyConfig()).Execute(context.Background(),
+			IdempotencyExecuteOptions{Atomic: true, IdempotencyKey: key}, func(context.Context) (any, error) {
+				t.Fatal("unsafe executor called")
+				return nil, nil
+			})
+		if key == "" {
+			require.ErrorIs(t, err, ErrIdempotencyKeyRequired)
+		} else {
+			require.ErrorIs(t, err, ErrIdempotencyStoreUnavail)
+		}
+		require.Empty(t, repo.data)
+	}
+}
+
+func TestIdempotencyCoordinator_AtomicModeReplaysAndReclaimsExpiredLease(t *testing.T) {
+	repo := &atomicIdempotencyTestRepo{inMemoryIdempotencyRepo: newInMemoryIdempotencyRepo()}
+	coordinator := NewIdempotencyCoordinator(repo, DefaultIdempotencyConfig())
+	opts := IdempotencyExecuteOptions{Scope: "financial", Method: "POST", Route: "/balance", IdempotencyKey: "atomic-key", Atomic: true}
+	count := 0
+	execute := func(context.Context) (any, error) {
+		require.True(t, repo.inside)
+		count++
+		return map[string]any{"count": count}, nil
+	}
+	_, err := coordinator.Execute(context.Background(), opts, execute)
+	require.NoError(t, err)
+	result, err := coordinator.Execute(context.Background(), opts, execute)
+	require.NoError(t, err)
+	require.True(t, result.Replayed)
+	require.Equal(t, 1, count)
+	// A rolled-back attempt remains processing until its lease can be fenced.
+	opts.IdempotencyKey = "expired-claim"
+	fingerprint, err := BuildIdempotencyFingerprint(opts.Method, opts.Route, opts.ActorScope, opts.Payload)
+	require.NoError(t, err)
+	past := time.Now().Add(-time.Minute)
+	_, err = repo.CreateProcessing(context.Background(), &IdempotencyRecord{Scope: opts.Scope, IdempotencyKeyHash: HashIdempotencyKey(opts.IdempotencyKey), RequestFingerprint: fingerprint, Status: IdempotencyStatusProcessing, LockedUntil: &past, ExpiresAt: time.Now().Add(time.Hour)})
+	require.NoError(t, err)
+	_, err = coordinator.Execute(context.Background(), opts, execute)
+	require.NoError(t, err)
+	require.Equal(t, 2, count)
+}
+
+func TestIdempotencyCoordinator_AtomicCommitErrorPreservesReceipt(t *testing.T) {
+	repo := &atomicIdempotencyTestRepo{inMemoryIdempotencyRepo: newInMemoryIdempotencyRepo(), commitErr: errors.New("commit response lost")}
+	coordinator := NewIdempotencyCoordinator(repo, DefaultIdempotencyConfig())
+	opts := IdempotencyExecuteOptions{Scope: "financial", Method: "POST", Route: "/balance", IdempotencyKey: "ambiguous", Atomic: true}
+	_, err := coordinator.Execute(context.Background(), opts, func(context.Context) (any, error) { return "done", nil })
+	require.Error(t, err)
+	record, err := repo.GetByScopeAndKeyHash(context.Background(), opts.Scope, HashIdempotencyKey(opts.IdempotencyKey))
+	require.NoError(t, err)
+	require.Equal(t, IdempotencyStatusSucceeded, record.Status, "never overwrite a possibly committed receipt with retryable failure")
+}
+
+type failedBalanceHistoryRepo struct{ RedeemCodeRepository }
+
+func (failedBalanceHistoryRepo) Create(context.Context, *RedeemCode) error {
+	return errors.New("history unavailable")
+}
+
+func TestAdminService_UpdateUserBalance_HistoryFailurePropagates(t *testing.T) {
+	repo := &balanceUserRepoStub{userRepoStub: &userRepoStub{user: &User{ID: 7, Balance: 10}}}
+	invalidator := &authCacheInvalidatorStub{}
+	svc := &adminServiceImpl{userRepo: repo, redeemCodeRepo: failedBalanceHistoryRepo{}, authCacheInvalidator: invalidator}
+	_, err := svc.UpdateUserBalance(context.Background(), 7, 1, "add", "")
+	require.ErrorContains(t, err, "history unavailable")
+	require.Empty(t, invalidator.userIDs)
+}
+
+func TestApplyUsageBilling_RejectsMissingRepository(t *testing.T) {
+	p := &postUsageBillingParams{Cost: &CostBreakdown{ActualCost: 1}, User: &User{ID: 7}, APIKey: &APIKey{ID: 2}, Account: &Account{ID: 3}}
+	_, err := applyUsageBilling(context.Background(), "request", &UsageLog{}, p, &billingDeps{}, nil)
+	require.ErrorContains(t, err, "atomic usage billing unavailable")
+}
